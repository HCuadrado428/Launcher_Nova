# Copia este archivo como .env para probar en local (node --env-file=.env src/index.js).
# En Railway estas variables se ponen en la pestaña "Variables".

# Obligatoria. Genera una con: openssl rand -hex 32
JWT_SECRET=

# Obligatoria para entrar al panel. ID de cliente OAuth de Google (tipo "Aplicación web").
GOOGLE_CLIENT_ID=

# Único correo que puede entrar al panel.
OWNER_EMAIL=noovaasmp@gmail.com

# Carpeta donde se guardan los mods y la lista de admins. En Railway no hace
# falta: se usa sola la ruta del volumen que montes.
# DATA_DIR=/data
