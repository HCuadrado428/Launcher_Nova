{
  "name": "nova-launcher",
  "version": "1.8.0",
  "description": "Nova Launcher — el launcher del SMP NOVA 2: inicia sesión, se baja el modpack y entra",
  "author": "HCuadrado428",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win --publish always",
    "test": "node --test"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-updater": "^6.8.9",
    "msmc": "^4.1.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hcuadrado428.novalauncher",
    "productName": "Nova Launcher",
    "files": [
      "**/*",
      "!test/**",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "HCuadrado428",
      "repo": "Launcher_Nova",
      "releaseType": "release"
    }
  },
  "overrides": {
    "@xmcl/asm": "1.0.1",
    "@xmcl/file-transfer": "2.0.3",
    "@xmcl/forge-site-parser": "2.0.9",
    "@xmcl/task": "4.1.1",
    "@xmcl/unzip": "2.1.2",
    "@xmcl/core": "2.15.1"
  },
  "license": "MIT"
}
